// ─────────────────────────────────────────────────────────────────────────────
// DentalGO CRM — Prisma Schema (Banco 2: PostgreSQL dedicado)
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// IAM — Usuários e Autenticação (NextAuth)
// roles válidos: "ADMIN" | "AGENT" | "POST_SALES"
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  /// Roles: "ADMIN" | "AGENT" | "POST_SALES"
  role          String    @default("AGENT")
  isActive      Boolean   @default(true)

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // CRM/CDP relations
  assignedCustomers Customer[]
  interactions      Interaction[]
  tasks             Task[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM & CDP — As 6 Entidades de Ouro
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id                String        @id @default(cuid())
  externalPersonId  Int
  stage             String        @default("novo_cadastro")
  assigneeId        String?
  pipelineId        String?
  journeyId         String?
  joinedJourneyAt   DateTime?
  metadata          Json?         @default("{}") // Armazena Instagram, especialidade, rede social, etc.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastInteractionAt DateTime?
  interactionCount  Int           @default(0)
  lossReason        String?
  tag               String?
  scheduledFor      DateTime?
  frozenUntil       DateTime?
  freezeReason      String?
  lostReason        String?

  // Relations
  assignee     User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  pipeline     Pipeline?     @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  journey      Journey?      @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  interactions Interaction[]
  tasks        Task[]

  @@unique([externalPersonId, journeyId])
}

model Journey {
  id             String       @id @default(cuid())
  name           String
  status         String       @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  objective      String
  financialGoal  Float?
  targetCriteria String?
  limitPerDay    Int?
  flowGraph      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  customers      Customer[]
  tasks          Task[]
  automations    Automation[]
}

model Pipeline {
  id          String     @id @default(cuid())
  name        String     @unique // "Vendas" | "CS" | "Nutrição"
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  customers   Customer[]
}

model Interaction {
  id         String   @id @default(cuid())
  customerId String
  text       String
  authorId   String
  createdAt  DateTime @default(now())

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Task {
  id               String    @id @default(cuid())
  customerId       String
  assignedToId     String?
  journeyId        String?
  automationId     String?
  scheduledFor     DateTime
  taskType         String    // "WHATSAPP" | "EMAIL" | "CALL" | "ABANDONED_CART" | "EXPIRATION" | "POST_SALE"
  status           String    @default("PENDING") // "PENDING" | "COMPLETED" | "SKIPPED" | "CANCELED"
  completionNote   String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Snapshots/Metadata para pós-vendas
  snapshotPlanId   Int?
  snapshotPlanName String?

  // Relations
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  journey    Journey?    @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
}

model Automation {
  id           String   @id @default(cuid())
  name         String
  triggerEvent String   // "CART_ABANDONED" | "SUBSCRIPTION_EXPIRING" | "NEW_SIGNUP" | "POST_SALE"
  conditions   Json?
  actionType   String   // "CREATE_TASK"
  actionConfig Json?    // Configuração contendo templateMessage, dayOffset, channel, etc.
  isActive     Boolean  @default(true)
  journeyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  tasks   Task[]
}
