// ─────────────────────────────────────────────────────────────────────────────
// DentalGO CRM — Prisma Schema (Banco 2: PostgreSQL dedicado)
// ─────────────────────────────────────────────────────────────────────────────

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// IAM — Usuários e Autenticação (NextAuth)
// roles válidos: "ADMIN" | "AGENT" | "POST_SALES"
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  /// Roles: "ADMIN" | "AGENT" | "POST_SALES"
  role          String    @default("AGENT")
  isActive      Boolean   @default(true)
  skills        String[]

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  // CRM/CDP relations
  assignedCustomers Customer[]
  interactions      Interaction[]
  tasks             Task[]
  opportunities     Opportunity[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// CRM & CDP — As 6 Entidades de Ouro
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id                String        @id @default(cuid())
  externalPersonId  Int?          // Optional for leads outside the legacy system
  source            String        @default("DENTALGO") // e.g., DENTALGO, CSV, MANUAL, LP
  acquisitionChannel String?      // e.g., ORGANIC_SEARCH, INSTAGRAM_ADS, INDICAÇÃO, EVENTO_PRESENCIAL
  leadSource        String?       // General marketing macro source
  totalLifetimeValue Float        @default(0.0)
  stage             String        @default("novo_cadastro") // Legacy, to be migrated to Opportunity
  assigneeId        String?
  pipelineId        String?       // Legacy, to be migrated to Opportunity
  journeyId         String?
  joinedJourneyAt   DateTime?
  metadata          Json?         @default("{}") // Armazena Instagram, especialidade, rede social, etc.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  lastInteractionAt DateTime?
  interactionCount  Int           @default(0)
  lossReason        String?       // Legacy, to be migrated to Opportunity
  tag               String?
  scheduledFor      DateTime?
  frozenUntil       DateTime?     // Legacy, to be migrated to Opportunity
  freezeReason      String?       // Legacy, to be migrated to Opportunity
  humanTakeover     Boolean       @default(false) // Legacy, to be migrated to Opportunity
  lostReason        String?       // Legacy, to be migrated to Opportunity
  leadScore         Int           @default(0)
  isInNurturing     Boolean       @default(false)
  nurturingJourneyId String?

  // Relations
  assignee         User?             @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  pipeline         Pipeline?         @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  journey          Journey?          @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  interactions     Interaction[]
  tasks            Task[]
  flowExecutions   FlowExecution[]
  opportunities    Opportunity[]
  customerProducts CustomerProduct[]

  @@unique([externalPersonId, journeyId])
}

model Journey {
  id             String       @id @default(cuid())
  name           String
  status         String       @default("ACTIVE") // "ACTIVE" | "PAUSED" | "COMPLETED"
  objective      String
  campaignNature String       @default("COMMERCIAL") // "COMMERCIAL" | "AUTOMATED"
  financialGoal  Float?
  targetCriteria String?
  limitPerDay    Int?
  flowGraph      String?
  durationDays   Int          @default(30)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Routing fields
  routingMode       String         @default("ROUND_ROBIN")
  useAccountManager Boolean        @default(false)
  strictSkillMatch  Boolean        @default(false)
  productId         String?
  product           Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Mailer Integration
  smtpConfigId             String?
  smtpConfig               SmtpConfig?    @relation(fields: [smtpConfigId], references: [id], onDelete: SetNull)
  templateId               String?
  template                 Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sendingMode              String         @default("IMMEDIATE") // IMMEDIATE, FIXED, RANDOM
  minDelay                 Int            @default(100)        // em ms
  maxDelay                 Int            @default(1000)       // em ms (usado se RANDOM)
  totalEmails              Int            @default(0)
  sentEmails               Int            @default(0)
  failedEmails             Int            @default(0)
  openedEmails             Int            @default(0)
  nextCampaignId           String?        @unique
  nextCampaignDelayMinutes Int            @default(0)
  nextCampaign             Journey?       @relation("LinkedCampaigns", fields: [nextCampaignId], references: [id], onDelete: SetNull)
  prevCampaign             Journey?       @relation("LinkedCampaigns")

  // Marketing, Pipeline & Post-Sales Routing
  warmupTemplateId         String?
  pipelineId               String?
  onWinJourneyId           String?
  onWinJourney             Journey?       @relation("JourneyToWin", fields: [onWinJourneyId], references: [id], onDelete: SetNull)
  onLoseJourneyId          String?
  onLoseJourney            Journey?       @relation("JourneyToLose", fields: [onLoseJourneyId], references: [id], onDelete: SetNull)
  wonJourneys              Journey[]      @relation("JourneyToWin")
  lostJourneys             Journey[]      @relation("JourneyToLose")

  // Relations
  customers      Customer[]
  tasks          Task[]
  automations    Automation[]
  recipients     RecipientLog[]
}

model Pipeline {
  id          String     @id @default(cuid())
  name        String     @unique // "Vendas" | "CS" | "Nutrição"
  description String?
  
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  routingMode       String    @default("ROUND_ROBIN")
  useAccountManager Boolean   @default(false)
  strictSkillMatch  Boolean   @default(false)

  // Relations
  customers     Customer[]
  opportunities Opportunity[]
  forms         Form[]
}

model Interaction {
  id             String   @id @default(cuid())
  customerId     String
  text           String
  authorId       String?
  createdAt      DateTime @default(now())
  
  // Mailer/Notification extension
  type           String?  // EMAIL_SENT, WHATS_SENT, etc.
  metadata       Json?    @default("{}")
  deliveryStatus String   @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  errorMessage   String?
  channel        String?

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  author   User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Task {
  id               String    @id @default(cuid())
  customerId       String
  assignedToId     String?
  journeyId        String?
  automationId     String?
  scheduledFor     DateTime
  taskType         String    // "WHATSAPP" | "EMAIL" | "CALL" | "ABANDONED_CART" | "EXPIRATION" | "POST_SALE"
  status           String    @default("PENDING") // "PENDING" | "COMPLETED" | "SKIPPED" | "CANCELED"
  completionNote   String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Snapshots/Metadata para pós-vendas
  snapshotPlanId   Int?
  snapshotPlanName String?

  // Relations
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  
  assignedTo User?       @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  journey    Journey?    @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)
}

model Automation {
  id           String   @id @default(cuid())
  name         String
  triggerEvent String   // "CART_ABANDONED" | "SUBSCRIPTION_EXPIRING" | "NEW_SIGNUP" | "POST_SALE"
  conditions   Json?
  actionType   String   // "CREATE_TASK"
  actionConfig Json?    // Configuração contendo templateMessage, dayOffset, channel, etc.
  isActive     Boolean  @default(true)
  journeyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Template Engine
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel      String?   // "WHATSAPP" | "EMAIL" | "CALL"
  delay        Int?      // delay em minutos ou dias
  provider     String?   // "Mailer" | "Evolution" etc
  retry        Int?      @default(3)
  timeout      Int?      @default(5000)
  stepNumber   Int       @default(1)
  delayDays    Int       @default(0)

  // Relations
  journey Journey? @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  tasks   Task[]
}

model SmtpConfig {
  id        String     @id @default(cuid())
  name      String
  host      String
  port      Int
  user      String
  pass      String     // Encrypted
  secure    Boolean    @default(false)
  active    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  journeys  Journey[]
}

model Template {
  id          String       @id @default(cuid())
  name        String
  description String?
  type        String       // EMAIL, WHATSAPP, etc.
  version     Int          @default(1)
  status      String       @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  language    String       @default("PT") // PT, EN, ES
  subject     String?
  content     String       @db.Text
  variables   Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  automations Automation[]
  journeys    Journey[]
}

model RecipientLog {
  id         String    @id @default(cuid())
  journeyId  String
  journey    Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  email      String
  data       Json      // Variables parsed from Excel row
  status     String    @default("PENDING") // PENDING, SENT, FAILED
  opened     Boolean   @default(false)
  openedAt   DateTime?
  error      String?
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// V2 CRM ARCHITECTURE: Campaigns, Flows, Funnels
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id             String    @id @default(cuid())
  name           String
  description    String?
  objective      String
  campaignNature String    @default("COMMERCIAL") // "COMMERCIAL" | "AUTOMATED"
  targetCriteria String?   // JSON segment rules
  financialGoal  Float?
  status         String    @default("ACTIVE")
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  
  flowId         String?
  flow           Flow?     @relation(fields: [flowId], references: [id])
  
  opportunities  Opportunity[]
  forms          Form[]

  routingMode       String    @default("ROUND_ROBIN")
  useAccountManager Boolean   @default(false)
  strictSkillMatch  Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Flow {
  id          String      @id @default(cuid())
  name        String
  description String?
  status      String      @default("ACTIVE")
  
  campaigns   Campaign[]
  steps       FlowStep[]
  executions  FlowExecution[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model FlowStep {
  id           String    @id @default(cuid())
  flowId       String
  flow         Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  type         String    // "MESSAGE", "DELAY", "CONDITION", "ACTION"
  order        Int
  
  // Fields for MESSAGE
  templateId   String?
  
  // Fields for DELAY
  delayMinutes Int?
  
  // Fields for ACTION (e.g. Move to Funnel)
  targetPipelineId String?
  targetStage      String?
  
  nextStepId   String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model FlowExecution {
  id             String    @id @default(cuid())
  flowId         String
  flow           Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  currentStepId  String?
  status         String    @default("RUNNING") // "RUNNING", "PAUSED", "COMPLETED", "FAILED"
  
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// V4 CRM ARCHITECTURE: Universal CDP (Products & Opportunities)
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  category    ProductCategory @default(CURSO)
  subType     ProductSubType  @default(ONLINE)
  basePrice   Float?    // Base catalog price
  price       Float?
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pipelines        Pipeline[]
  campaigns        Campaign[]
  journeys         Journey[]
  opportunities    Opportunity[]
  customerProducts CustomerProduct[]
  forms            Form[]
}

model CustomerProduct {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  status     String    @default("ACTIVE") // ACTIVE, CANCELED, EXPIRED, COMPLETED
  startDate  DateTime?
  endDate    DateTime?
  pricePaid  Float?
  saleChannel SaleChannel?
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Opportunity {
  id             String    @id @default(cuid())
  
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  pipelineId     String
  pipeline       Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  
  stage          String    @default("novo_cadastro")
  status         String    @default("OPEN") // OPEN, WON, LOST
  value          Float?
  
  assigneeId     String?
  assignee       User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  sourceCampaignId String?
  sourceCampaign   Campaign? @relation(fields: [sourceCampaignId], references: [id], onDelete: SetNull)
  
  // Matriz de Canais - Canal de Venda (Onde ocorreu a venda física)
  saleChannel      SaleChannel?
  pricePaid        Float?
  
  // UTM Rastreamento Inbound
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  utmTerm          String?
  utmContent       String?
  
  // Marketing Campaign Spend relation
  marketingCampaignId String?
  marketingCampaign   MarketingCampaign? @relation(fields: [marketingCampaignId], references: [id], onDelete: SetNull)
  
  lossReason     String?
  humanTakeover  Boolean   @default(false)
  freezeReason   String?
  metadata       Json?     @default("{}")
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  tasks          Task[]
  interactions   Interaction[]
  flowExecutions FlowExecution[]
}

// ─────────────────────────────────────────────────────────────────────────────
// V5 REV-OPS & MARKETING HUB ENTITIES
// ─────────────────────────────────────────────────────────────────────────────

model MarketingCampaign {
  id            String        @id @default(cuid())
  name          String
  platform      String        // Ex: META, GOOGLE
  totalSpend    Float         @default(0.0)
  active        Boolean       @default(true)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  opportunities Opportunity[]
}

model Form {
  id             String      @id @default(cuid())
  name           String
  redirectUrl    String?
  successMessage String?
  styleConfig    Json        @default("{}") // Cores, bordas, tipografia, transparência
  
  pipelineId     String
  pipeline       Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId        String?     // Estágio inicial padrão
  
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  
  productId      String?
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  fields         FormField[]
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model FormField {
  id         String    @id @default(cuid())
  formId     String
  form       Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  name       String    // Ex: "name", "email", "whatsapp", "city"
  label      String    // Ex: "Seu Nome Completo"
  type       String    // Ex: "text", "email", "select", "checkbox"
  options    Json      @default("[]") // Lista de opções configuráveis para múltiplos campos
  required   Boolean   @default(false)
  order      Int       @default(0)
  
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum ProductCategory {
  CURSO
  CONGRESSO
  SAAS
  LIVRO
  INSTITUCIONAL
}

enum ProductSubType {
  IMERSAO
  APERFEICOAMENTO
  ESPECIALIZACAO
  EXCELENCIA
  PARCERIA
  PRESENCIAL
  ONLINE
  LIVRO_FISICO
  LIVRO_DIGITAL
}

enum SaleChannel {
  SITE
  EVENTO_PRESENCIAL
  TELEVENDAS
  INBOUND_FORM
}
